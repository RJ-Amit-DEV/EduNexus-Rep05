
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperUser() {
      return isAuthenticated() &&
        request.auth.token.email in [
          "amitjadhav4306@gmail.com",
          "guptakunal4575@gmail.com",
          "krishnagosavi880@gmail.com",
          "rushabhhirave@gmail.com"
        ];
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasProfile() {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function teacherOwnsClass(classCode) {
      return hasProfile() &&
        userProfile().role == 'teacher' &&
        userProfile().classCode == classCode;
    }

    // Superuser access
    match /{document=**} {
      allow read, write: if isSuperUser();
    }

    // User profiles and private subcollections
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isSuperUser() || (
        isOwner(userId) &&
        request.resource.data.get('role', null) == 'student' &&
        request.resource.data.get('studentId', null) == null &&
        request.resource.data.get('parentId', null) == null &&
        request.resource.data.get('childStudentId', null) == null &&
        request.resource.data.get('classCode', null) == null
      );

      allow update: if isSuperUser() || (
        isOwner(userId) &&
        request.resource.data.get('role', null) ==
          resource.data.get('role', null) &&
        request.resource.data.get('parentId', null) ==
          resource.data.get('parentId', null) &&
        request.resource.data.get('childStudentId', null) ==
          resource.data.get('childStudentId', null) &&
        request.resource.data.get('studentId', null) ==
          resource.data.get('studentId', null) &&
        request.resource.data.get('classCode', null) ==
          resource.data.get('classCode', null)
      );

      allow delete: if isSuperUser() || isOwner(userId);

      match /deadlines/{deadlineId} {
        allow read, write: if isOwner(userId);
      }

      match /quiz_results/{resultId} {
        allow read, write: if isOwner(userId);
      }

      match /schedules/{scheduleId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /scheduler_messages/{messageId} {
        allow read, write: if isOwner(userId);
      }

      match /{subTab}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Student academic records
    match /students/{studentDocId} {
      allow read: if hasProfile() && (
        (
          userProfile().role == 'teacher' &&
          resource.data.classCode == userProfile().classCode
        ) ||
        (
          userProfile().role == 'parent' &&
          userProfile().parentId != null &&
          userProfile().childStudentId != null &&
          resource.data.parentId == userProfile().parentId &&
          resource.data.studentId == userProfile().childStudentId
        ) ||
        (
          userProfile().role == 'student' &&
          resource.data.studentId == userProfile().studentId
        )
      );

      allow create: if teacherOwnsClass(
        request.resource.data.classCode
      );

      allow update: if teacherOwnsClass(resource.data.classCode) &&
        request.resource.data.classCode == resource.data.classCode;

      allow delete: if teacherOwnsClass(resource.data.classCode);
    }

    // Audience-restricted institutional notices
    match /notices/{noticeId} {
      function validAudience(audience) {
        return audience in [
          'all', 'students', 'parents', 'specific'
        ];
      }

      function canReadNotice() {
        return hasProfile() && (
          userProfile().role == 'teacher' ||
          resource.data.targetAudience == 'all' ||
          (
            userProfile().role == 'student' &&
            resource.data.targetAudience == 'students'
          ) ||
          (
            userProfile().role == 'parent' &&
            resource.data.targetAudience == 'parents'
          ) ||
          (
            resource.data.targetAudience == 'specific' &&
            resource.data.get('recipientUids', []) is list &&
            request.auth.uid in resource.data.get('recipientUids', [])
          )
        );
      }

      allow read: if canReadNotice();

      allow create: if hasProfile() &&
        userProfile().role == 'teacher' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.content.size() > 0 &&
        validAudience(request.resource.data.targetAudience) &&
        (
          request.resource.data.targetAudience != 'specific' ||
          (
            request.resource.data.get('recipientUids', []) is list &&
            request.resource.data.recipientUids.size() > 0
          )
        );

      // Notices cannot be edited after publication.
      allow update: if false;

      allow delete: if isSuperUser() ||
        (
          isAuthenticated() &&
          resource.data.authorId == request.auth.uid
        );
    }

    // Shared discussion: authenticate author and validate content
    match /messages/{messageId} {
      allow read: if isAuthenticated();

      allow create: if hasProfile() &&
        userProfile().role in ['teacher', 'student'] &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.role == userProfile().role &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000;

      allow update: if false;

      allow delete: if isSuperUser() ||
        (
          isAuthenticated() &&
          (
            resource.data.authorId == request.auth.uid ||
            (
              hasProfile() &&
              userProfile().role == 'teacher'
            )
          )
        );
    }
  }
}
