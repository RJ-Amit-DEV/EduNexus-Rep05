rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperUser() {
      return isAuthenticated() && 
             (request.auth.token.email in [
               "amitjadhav4306@gmail.com",
               "guptakunal4575@gmail.com",
               "krishnagosavi880@gmail.com",
               "rushabhhirave@gmail.com"
             ]);
    }

    // GLOBAL SUPERUSER FULL ACCESS
    match /{document=**} {
      allow read, write: if isSuperUser();
    }

    // User Profiles
    match /users/{userId} {
      // Authenticated institutional users can view profiles (for directory, doubt solver, mentor lookup)
      allow read: if isAuthenticated();
      
      // Parent-child and role bindings are institution-managed identity fields.
      // A user cannot create a parent account or edit their own role/link to another child.
      allow create: if isSuperUser() || (
        isOwner(userId) &&
        request.resource.data.get('role', null) == 'student' &&
        request.resource.data.get('studentId', null) == null &&
        request.resource.data.get('parentId', null) == null &&
        request.resource.data.get('childStudentId', null) == null &&
        request.resource.data.get('classCode', null) == null
      );
      allow update: if isSuperUser() || (
        isOwner(userId) &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('parentId', null) == resource.data.get('parentId', null) &&
        request.resource.data.get('childStudentId', null) == resource.data.get('childStudentId', null) &&
        request.resource.data.get('studentId', null) == resource.data.get('studentId', null) &&
        request.resource.data.get('classCode', null) == resource.data.get('classCode', null)
      );
      allow delete: if isSuperUser() || isOwner(userId);

      // User Deadlines Subcollection
      match /deadlines/{deadlineId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      }

      // Quiz Results Subcollection
      match /quiz_results/{resultId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      }

      // AI Schedules Subcollection
      match /schedules/{scheduleId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      }

      // Smart Notes Subcollection
      match /notes/{noteId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      }

      // Scheduler Chat Messages Subcollection
      match /scheduler_messages/{messageId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      }

      // Any other user sub-tab collection
      match /{subTab}/{docId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isSuperUser());
      }
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function teacherOwnsClass(classCode) {
      return isAuthenticated() &&
             userProfile().role == 'teacher' &&
             userProfile().classCode == classCode;
    }

    // Student records are scoped to the linked parent, the student, or the student's teacher.
    match /students/{studentDocId} {
      allow read: if isSuperUser() || (
        isAuthenticated() && (
          (userProfile().role == 'teacher' && resource.data.classCode == userProfile().classCode) ||
          (userProfile().role == 'parent' &&
            userProfile().parentId != null &&
            userProfile().childStudentId != null &&
            resource.data.parentId == userProfile().parentId &&
            resource.data.studentId == userProfile().childStudentId) ||
          (userProfile().role == 'student' && resource.data.studentId == userProfile().studentId)
        )
      );

      allow create: if isSuperUser() ||
        (teacherOwnsClass(request.resource.data.classCode));

      allow update: if isSuperUser() ||
        (teacherOwnsClass(resource.data.classCode) &&
         request.resource.data.classCode == resource.data.classCode);

      allow delete: if isSuperUser() || teacherOwnsClass(resource.data.classCode);
    }

    // Global Institutional Notice Board.
    // Only authenticated teachers can publish notices; authors or teachers can remove them.
    match /notices/{noticeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        userProfile().role == 'teacher' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.content is string &&
        request.resource.data.targetAudience in ['all', 'students', 'parents', 'specific'];
      allow update: if false;
      allow delete: if isSuperUser() ||
        (isAuthenticated() &&
          (resource.data.authorId == request.auth.uid || userProfile().role == 'teacher'));
    }

    // Global Doubt Solver Discussions.
    // Messages must be authored by the signed-in account with its server-stored role.
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        userProfile().role in ['teacher', 'student'] &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.role == userProfile().role &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000;
      allow update: if false;
      allow delete: if isSuperUser() ||
        (isAuthenticated() &&
          (resource.data.authorId == request.auth.uid || userProfile().role == 'teacher'));
    }
  }
}
