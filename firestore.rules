rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  function admin(){return signedIn() && request.auth.token.email in ["amitjadhav4306@gmail.com","guptakunal4575@gmail.com","krishnagosavi880@gmail.com","rushabhhirave@gmail.com"];}
  function hasProfile(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));}
  function p(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}
  function ownsStudent(){return hasProfile() && p().role == 'teacher' && resource.data.teacherUid == request.auth.uid && resource.data.classCode == p().classCode;}
  match /{document=**}{allow read,write:if admin();}
  match /users/{uid}{
   allow read:if owner(uid) || (hasProfile() && p().role in ['teacher','student'] && resource.data.get('classCode',null) == p().classCode);
   allow create,delete:if false;
   allow update:if owner(uid) && request.resource.data.role == resource.data.role &&
    request.resource.data.get('classCode',null) == resource.data.get('classCode',null) &&
    request.resource.data.get('studentId',null) == resource.data.get('studentId',null) &&
    request.resource.data.get('studentDocId',null) == resource.data.get('studentDocId',null) &&
    request.resource.data.get('parentId',null) == resource.data.get('parentId',null) &&
    request.resource.data.get('childStudentId',null) == resource.data.get('childStudentId',null) &&
    request.resource.data.get('childStudentDocId',null) == resource.data.get('childStudentDocId',null) &&
    request.resource.data.get('parentLinkId',null) == resource.data.get('parentLinkId',null);
   match /deadlines/{id}{allow read,write:if owner(uid);}
   match /quiz_results/{id}{allow read,write:if owner(uid);}
   match /schedules/{id}{allow read,write:if owner(uid);}
   match /notes/{id}{allow read,write:if owner(uid);}
   match /scheduler_messages/{id}{allow read,write:if owner(uid);}
   match /{subcollection}/{id}{allow read,write:if owner(uid);}
  }
  match /classes/{classCode}{
   allow read:if signedIn() && (resource.data.teacherUid == request.auth.uid || (hasProfile() && p().classCode == classCode && p().role in ['student','parent']));
   allow create,update,delete:if false;
  }
  match /students/{id}{
   allow get:if admin() || ownsStudent() || (hasProfile() && ((p().role == 'student' && resource.data.studentUid == request.auth.uid) || (p().role == 'parent' && resource.data.parentUid == request.auth.uid)));
   allow list:if admin() || (hasProfile() && p().role == 'teacher' && resource.data.teacherUid == request.auth.uid && resource.data.classCode == p().classCode);
   allow create,delete:if false;
   allow update:if admin() || (ownsStudent() && request.resource.data.teacherUid == resource.data.teacherUid && request.resource.data.classCode == resource.data.classCode && request.resource.data.studentUid == resource.data.studentUid && request.resource.data.parentUid == resource.data.parentUid && request.resource.data.studentId == resource.data.studentId && request.resource.data.rollNo == resource.data.rollNo && request.resource.data.parentLinkId == resource.data.parentLinkId);
  }
  match /parentLinks/{id}{allow read,write:if false;}
  match /teacherInvites/{id}{allow read,write:if false;}
  match /notices/{id}{
   function audience(a){return a in ['all','students','parents','specific'];}
   function canRead(){return hasProfile() && (p().role == 'teacher' || resource.data.targetAudience == 'all' || (p().role == 'student' && resource.data.targetAudience == 'students') || (p().role == 'parent' && resource.data.targetAudience == 'parents') || (resource.data.targetAudience == 'specific' && resource.data.get('recipientUids',[]) is list && request.auth.uid in resource.data.get('recipientUids',[])));}
   allow read:if canRead();
   allow create:if hasProfile() && p().role == 'teacher' && request.resource.data.authorId == request.auth.uid && request.resource.data.classCode == p().classCode && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.content is string && request.resource.data.content.size()>0 && audience(request.resource.data.targetAudience) && (request.resource.data.targetAudience != 'specific' || (request.resource.data.get('recipientUids',[]) is list && request.resource.data.recipientUids.size()>0));
   allow update:if false;
   allow delete:if admin() || (signedIn() && resource.data.authorId == request.auth.uid);
  }
  match /messages/{id}{
   allow read:if signedIn() && hasProfile() && p().role in ['teacher','student'] && resource.data.classCode == p().classCode;
   allow create:if hasProfile() && p().role in ['teacher','student'] && request.resource.data.authorId == request.auth.uid && request.resource.data.role == p().role && request.resource.data.classCode == p().classCode && request.resource.data.content is string && request.resource.data.content.size()>0 && request.resource.data.content.size()<=5000;
   allow update:if false;
   allow delete:if admin() || (signedIn() && resource.data.authorId == request.auth.uid);
  }
 }
}