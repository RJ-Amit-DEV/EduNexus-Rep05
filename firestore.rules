rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function teacherOf(classCode) {
      return profileExists() && me().role == 'teacher' && me().classCode == classCode;
    }
    function superUser() {
      return signedIn() && request.auth.token.email in [
        "amitjadhav4306@gmail.com", "guptakunal4575@gmail.com",
        "krishnagosavi880@gmail.com", "rushabhhirave@gmail.com"
      ];
    }
    match /{document=**} {
      allow read, write: if superUser();
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
      match /{subcollection}/{docId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
    match /classes/{classCode} {
      allow read: if profileExists() && (
        (me().role == 'teacher' && me().classCode == classCode) ||
        (me().classCode == classCode && me().role in ['student', 'parent'])
      );
      allow write: if false;
    }
    match /teacherInvites/{inviteHash} {
      allow read, write: if false;
    }
    match /parentLinks/{linkHash} {
      allow read, write: if false;
    }
    match /students/{studentDocId} {
      allow get: if profileExists() && (
        (me().role == 'teacher' && resource.data.teacherUid == request.auth.uid) ||
        (me().role == 'student' && resource.data.studentUid == request.auth.uid) ||
        (me().role == 'parent' && resource.data.parentUid == request.auth.uid)
      );
      allow list: if profileExists() && me().role == 'teacher' &&
        resource.data.teacherUid == request.auth.uid;
      allow create, delete: if false;
      allow update: if profileExists() && me().role == 'teacher' &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.teacherUid == resource.data.teacherUid &&
        request.resource.data.classCode == resource.data.classCode &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.parentUid == resource.data.parentUid &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.parentId == resource.data.parentId &&
        request.resource.data.rollNo == resource.data.rollNo &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'cgpa', 'ia1', 'ia2', 'attendance', 'quizPass', 'updatedAt'
        ]);
    }
    match /notices/{noticeId} {
      function validAudience(a) { return a in ['all', 'students', 'parents', 'specific']; }
      function canRead() {
        return profileExists() && resource.data.classCode == me().classCode && (
          me().role == 'teacher' ||
          resource.data.targetAudience == 'all' ||
          (me().role == 'student' && resource.data.targetAudience == 'students') ||
          (me().role == 'parent' && resource.data.targetAudience == 'parents') ||
          (resource.data.targetAudience == 'specific' &&
            resource.data.get('recipientUids', []) is list &&
            request.auth.uid in resource.data.get('recipientUids', []))
        );
      }
      allow read: if canRead();
      allow create: if profileExists() && me().role == 'teacher' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.teacherUid == request.auth.uid &&
        request.resource.data.classCode == me().classCode &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.content is string && request.resource.data.content.size() > 0 &&
        validAudience(request.resource.data.targetAudience) &&
        (request.resource.data.targetAudience != 'specific' ||
          (request.resource.data.get('recipientUids', []) is list && request.resource.data.recipientUids.size() > 0));
      allow update: if false;
      allow delete: if profileExists() && me().role == 'teacher' &&
        resource.data.teacherUid == request.auth.uid;
    }
    match /messages/{messageId} {
      allow read: if profileExists() && me().role in ['teacher', 'student'] &&
        resource.data.classCode == me().classCode;
      allow create: if profileExists() && me().role in ['teacher', 'student'] &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.role == me().role &&
        request.resource.data.classCode == me().classCode &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 5000;
      allow update: if false;
      allow delete: if profileExists() && me().role == 'teacher' &&
        resource.data.teacherUid == request.auth.uid;
    }
  }
}
